# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log

# Dependency directories
node_modules/

# Environment variables
.env

# Bot configuration (contains tokens)
config.yml
config_backup_*.yml
config_pre_restore_*.yml

# Runtime/bot-generated state (never commit)
# Module runtime data lives INSIDE each module's folder (modules/<lang>/<name>/):
# source is tracked, the module's own configs/saves/logs are ignored.
bot.new
bot.old
updater_state.json
config_pre_restore_*.yml
.pi/
.tmp/

# Atomic-write siblings of the state files above (command_overrides.json.tmp,
# updater_state.json.tmp) plus module-side *.tmp staging: the temp file a writer
# creates between write and rename.
*.tmp

# Module runtime data (configs, saves, logs) inside module folders.
# A module with other data filenames can add its own .gitignore in its folder.
modules/Go/*/config*.yml
modules/Go/*/data/
modules/Go/*/logs/
modules/Python/*/config*.yml
modules/Python/*/config.json
modules/Python/*/data/
modules/Python/*/logs/
modules/Python/*/models/
modules/Lua/*/config*.yml
modules/Lua/*/config.json
modules/Lua/*/data/
modules/Lua/*/logs/
# Tickets compiled-in builtin runtime data (source lives in internal/builtin/tickets/)
modules/tickets/
# Imagefilter compiled-in builtin runtime data (source lives in internal/builtin/imagefilter/)
modules/imagefilter/
# Legacy Go plugin data dirs (pre-cutover runtime state)
modules/Go/*/guilds/
modules/Go/*/tickets/
modules/Go/*/spam_images/
modules/Go/*/config.json
# Retired Python module runtime data (image_spam_filter source removed in 0.2.0)
modules/Python/image_spam_filter/

# Python SDK IPC sockets / runtime droppings
modules/Python/*/*.sock
modules/Python/*/*.pid

# Legacy pre-restructure module config location (contains secrets)
module_configs/

# Go build/test droppings
*.test
coverage.out
coverage.html

# Bot binary (root-anchored: must NOT match cmd/bot/)
/bot

# Module persistence
loaded_modules.json

# Per-command command overrides (global + per-guild enable/disable/restrict)
command_overrides.json

# Python module venvs and caches
modules/Python/*/.venv/
modules/Python/*/__pycache__/
# Python SDK caches
__pycache__/
*.pyc

# Editor directories and files
.idea
.vscode

# Agent-local tooling state (never repo content). .claude/settings.local.json was
# previously excluded only by a machine-wide ~/.config/git/ignore, which does not
# travel with the repo — a fresh clone/CI would have committed it.
.claude/
.omp/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS specific
.DS_Store

# Built plugin binaries (artifacts, not source)
modules/Go/*/*.so
*.so

# Hermes agent workspace (plans, session state)
.hermes/

# Local dev experiments (never tracked)
scratch/
*.local.yml
*.local.yaml

# Leftover git worktrees from dev sessions
.worktrees/

# Dashboard redesign drafts (local only)
/redesign/

# ONNX Runtime C library + include tree (scripts/setup_imagefilter.sh, local only).
# The whole lib/ tree is local-only: no source-level file lives under it.
lib/

# imagefilter builtin model files (regenerable via scripts/setup_imagefilter.sh)
modules/imagefilter/models/
