# Logs
/logs/
*.log

# Environment / secrets (keep broad: never commit a secrets file from any dir)
.env

# Bot configuration (root; contains tokens)
/config.yml
/config_backup_*.yml
/config_pre_restore_*.yml

# Legal pages: deployment content edited in place and served at /tos + /policy.
# The dashboard seeds legal/terms.md and legal/privacy.md on first render.
/legal/

# Runtime/bot-generated state (never commit)
/bot.new
/bot.old
/updater_state.json
/loaded_modules.json
/command_overrides.json

# Atomic-write sibling files (command_overrides.json.tmp,
# updater_state.json.tmp, module staging, ...).
*.tmp

# Compiled-in builtin runtime data (source lives in internal/builtin/).
# modules/Go/ is the dashboard data home plus any legacy plugin-era state.
/modules/Go/
/modules/tickets/
/modules/imagefilter/
/modules/welcome/
/modules/moderation/
/modules/reactionroles/
/modules/leveling/

# Dynamic Lua/Python module runtime data. Source is tracked; configs, state,
# logs, models and venvs inside a module folder are not.
modules/Python/*/config*.yml
modules/Python/*/config.json
modules/Python/*/data/
modules/Python/*/logs/
modules/Python/*/models/
modules/Python/*/.venv/
modules/Lua/*/config*.yml
modules/Lua/*/config.json
modules/Lua/*/data/
modules/Lua/*/logs/

# Python caches
__pycache__/
*.pyc

# Go build/test droppings
*.test
coverage.out
coverage.html

# Bot binary (root-anchored: must NOT match cmd/bot/)
/bot

# Plugin/shared-library artifacts (the Go plugin path is gone; safety net)
*.so

# ONNX Runtime C library + include tree (scripts/setup_imagefilter.sh, local only)
/lib/

# Legacy pre-restructure module config location (may contain secrets)
module_configs/

# Agent/tool-local state (never repo content)
/.claude/
/.omp/
/.hermes/
/.worktrees/
/scratch/
*.local.yml
*.local.yaml

# Editor/OS files
.idea/
.vscode/
.DS_Store
*.sw?
